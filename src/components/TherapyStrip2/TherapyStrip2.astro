---
import styles from "./TherapyStrip2.module.css";
const {
  items = [
    "VIRTUAL AND IN-PERSON SESSIONS",
    "SPECIALIZING IN ANXIETY, DEPRESSION & LIFE STRESSORS",
    "NAVIGATING ADHD AND ITS IMPACT ON YOUR LIFE AND RELATIONSHIPS",
  ],
} = Astro.props;
---
<div class={styles.strip}>
  {items.map((item, i) => (
    <>
      {i > 0 && <div class={styles.divider}></div>}
      <div class={styles.stripItem}>{item}</div>
    </>
  ))}
</div>
