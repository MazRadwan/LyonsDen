---
import styles from "./TherapyHero.module.css";
import { Image } from "astro:assets";
import heroImage from "../../assets/lyonsdenhero6.png";
---
<!-- LCP element: render immediately visible (opacity:1), matching home's Hero.
     The old data-reveal fade (opacity 0→1 over 1s) delayed + destabilized the
     LCP image paint. Settled appearance is identical (golden master stays green). -->
<div class={styles.hero} style="opacity:1">
  <Image
    src={heroImage}
    alt="Therapy Services Hero"
    class={styles.heroImage}
    format="webp"
    loading="eager"
    fetchpriority="high"
    widths={[768, 1280, 1920]}
    sizes="100vw"
  />
  <div class={styles.heroMask}></div>
  <div class={styles.heroContent}>
    <h1>THERAPY SERVICES</h1>
    <p>
      Therapy for Teens and Adults in the New York, New Jersey and
      Connecticut
    </p>
  </div>
</div>
