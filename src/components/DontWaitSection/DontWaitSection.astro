---
import styles from "./DontWaitSection.module.css";
import ConsultationButton from "../ConsultationButton/ConsultationButton.astro";
import Button from "../Button/Button.astro";
import { Image } from "astro:assets";
import lionLogo from "../../assets/lyonsdenlogo2.png";
---
<div class={styles.section}>
  <div class={styles.container}>
    <Image src={lionLogo} alt="Logo" class={styles.logo} format="webp" width={400} loading="lazy" />
    <h2
      class={`${styles.h2} ${styles.animated}`}
      data-reveal
      data-reveal-class={styles.visible}
      data-reveal-threshold="0.5"
      data-reveal-margin="-50px"
      data-reveal-delay="300"
    >
      Don't wait to get the help you need.
    </h2>
    <p
      class={`${styles.p} ${styles.animated}`}
      data-reveal
      data-reveal-class={styles.visible}
      data-reveal-threshold="0.5"
      data-reveal-margin="-50px"
      data-reveal-delay="300"
    >
      Who we are is shaped by our experiences, environment, and biology.
      Sometimes, what once kept us safe and content no longer serves us, and
      it's time to find a new way.
    </p>
    <p
      class={`${styles.highlight} ${styles.animated}`}
      data-reveal
      data-reveal-class={styles.visible}
      data-reveal-threshold="0.5"
      data-reveal-margin="-50px"
      data-reveal-delay="300"
    >
      Set forth on a journey of self-discovery and empowerment.
    </p>
    <div class={styles.buttons}>
      <ConsultationButton
        href="https://www.therapyportal.com/p/alyonsden/appointments/availability/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book a Free Consultation
      </ConsultationButton>
      <Button
        href=" https://www.therapyportal.com/p/alyonsden/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Book an Appointment
      </Button>
    </div>
  </div>
</div>
