---
import styles from "./BottomHero.module.css";
import { getImage } from "astro:assets";
import _heroImage from "../../assets/lyonsdenhero5.jpeg";
const heroImage = (await getImage({ src: _heroImage, format: "webp", width: 1920 })).src;
import Button from "../Button/Button.astro";
import ConsultationButton from "../ConsultationButton/ConsultationButton.astro";
---
<section class={styles.bottomHero}>
  <div
    class={styles.heroImage}
    style={`background-image: url(${heroImage})`}
  >
    <div class={styles.overlay}></div>
    <div
      class={styles.content}
      data-reveal
      data-reveal-class={styles.animate}
      data-reveal-threshold="0.1"
    >
      <h2 class={styles.header}>A LYONS DEN THERAPY</h2>
      <p class={styles.subtext}>
        Make today the day you choose to invest in your well-being.
      </p>
      <!-- Components render their own <a> when given href — wrapper anchors
           left the inner pill content-sized, defeating equal widths. -->
      <div class={styles.buttonContainer}>
        <ConsultationButton
          href="https://www.therapyportal.com/p/alyonsden/appointments/availability/"
          target="_blank"
          rel="noopener noreferrer"
        >
          BOOK A FREE CONSULTATION
        </ConsultationButton>
        <Button
          href="https://www.therapyportal.com/p/alyonsden/"
          target="_blank"
          rel="noopener noreferrer"
        >
          BOOK AN APPOINTMENT
        </Button>
      </div>
    </div>
  </div>
</section>
