---
import styles from "./Footer.module.css";
import { Image } from "astro:assets";
import logoImg from "../../assets/lyonsdenlogo2.png";
---
<footer class={styles.footer}>
  <div class={styles.container}>
    <div class={styles.logoContainer}>
      <Image
        src={logoImg}
        alt="A Lyons Den Therapy Logo"
        class={styles.logo}
        format="webp"
        width={400}
        loading="lazy"
      />
      <div class={styles.siteNameContainer}>
        <span class={styles.siteName}>A LYONS DEN</span>
        <hr class={styles.separator} />
        <span class={styles.siteSubName}>THERAPY</span>
      </div>
    </div>

    <div class={styles.linksSection}>
      <div class={styles.linkColumn}>
        <h3 class={styles.linkHeader}>GET STARTED</h3>
        <a
          href="https://www.therapyportal.com/p/alyonsden/appointments/availability/"
          target="_blank"
          rel="noopener noreferrer"
          class={styles.link}
        >
          Book a Free Consultation
        </a>
        <a
          href="https://www.therapyportal.com/p/alyonsden/"
          target="_blank"
          rel="noopener noreferrer"
          class={styles.link}
        >
          Book an appointment
        </a>
        <a href="tel:+16465351262" class={styles.link}>
          (646) 535-1262
        </a>
        <a href="#contact" class={styles.link}>
          Contact Form
        </a>
      </div>

      <div class={styles.linkColumn}>
        <h3 class={styles.linkHeader}>QUICK LINKS</h3>
        <a href="#about" class={styles.link}>
          About Adam
        </a>
        <a href="/services" class={styles.link}>
          Therapy Services
        </a>
        <a href="/adhd-coaching" class={styles.link}>
          ADHD Coaching
        </a>
        <a
          href="https://alyonsdentherapy.blogspot.com/"
          target="_blank"
          rel="noopener noreferrer"
          class={styles.link}
        >
          Mental Health &amp; ADHD Blog
        </a>
        <a
          href="https://www.therapyportal.com/p/alyonsden/"
          target="_blank"
          rel="noopener noreferrer"
          class={styles.link}
        >
          Client Portal
        </a>
      </div>

      <div class={styles.linkColumn}>
        <h3 class={styles.linkHeader}>SERVICING</h3>
        <p class={styles.address}>
          New York and New Jersey
          <br />
          Virtual and In-Person
        </p>
      </div>
    </div>
  </div>
  <div class={styles.copyright}>
    Adam Lyons, LCSW &nbsp;·&nbsp; NY License #084681-01 &nbsp;·&nbsp; NJ
    License #44SC06328000
    <br />
    2026 A Lyons Den Therapy. All Rights reserved
  </div>
</footer>
