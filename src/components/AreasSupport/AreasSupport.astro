---
import styles from "./AreasSupport.module.css";
import { Image } from "astro:assets";
import iconImg from "../../assets/lyonsdenlogo2.png";

const supportAreas = [
  {
    title: "ANXIETY",
    description:
      "Discover strategies to manage and reduce anxiety, finding relief from persistent worry and stress.",
  },
  {
    title: "DEPRESSION",
    description:
      "Explore ways to address feelings of sadness and hopelessness with supportive, effective techniques.",
  },
  {
    title: "THERAPY FOR TEENS",
    description:
      "Tailored therapy designed to support adolescents through the unique challenges of their teenage years.",
  },
  {
    title: "STRESS & LIFE TRANSITIONS",
    description:
      "Gain guidance for managing life's changes and stressors with practical, solution-focused support.",
  },
  {
    title: "ADHD & NEURODIVERGENCE",
    description:
      "Receive specialized support for managing ADHD and other neurodivergent conditions, leveraging personal insights and strategies.",
  },
  {
    title: "TRAUMA, PTSD & C-PTSD",
    description:
      "Find healing from past traumatic experiences, and lessen the impact on your current life.",
  },
];
---
<div class={styles.sectionWrapper}>
  <section class={styles.section}>
    <h2
      class={styles.heading}
      data-reveal
      data-reveal-class={styles.animateHeading}
      data-reveal-threshold="0.1"
    >
      Areas of Support
    </h2>
    <p
      class={styles.subtext}
      data-reveal
      data-reveal-class={styles.animateSubtext}
      data-reveal-threshold="0.1"
    >
      Adam is trained to gently guide you through the process of healing
      your relationship with yourself and others.
    </p>
    <div class={styles.grid}>
      {supportAreas.map((area, index) => (
        <div
          class={styles.box}
          data-reveal
          data-reveal-class={styles.animateBox}
          data-reveal-threshold="0.1"
          data-reveal-delay={String(index * 100)}
        >
          <Image src={iconImg} alt="Support icon" class={styles.icon} format="webp" width={160} loading="lazy" />
          <h2 class={styles.boxTitle}>{area.title}</h2>
          <p class={styles.boxDescription}>{area.description}</p>
          <a href="/services" class={styles.button}>Learn More</a>
        </div>
      ))}
    </div>
  </section>
</div>
