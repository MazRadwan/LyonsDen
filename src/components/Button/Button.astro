---
import styles from "./Button.module.css";
const { href, target, rel, type = "button", class: className = "" } = Astro.props;
---
{href ? (
  <a href={href} target={target} rel={rel} class={`${styles.button} ${className}`}><slot /></a>
) : (
  <button type={type} class={`${styles.button} ${className}`}><slot /></button>
)}
