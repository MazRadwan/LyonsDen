---
/**
 * services.astro — Therapy Services page (/services)
 *
 * Composes the static .astro sections in the exact order from audit-report §A
 * "Services /services stack". The 4 interactive components (Header, Specialization,
 * OurApproach, FaqSection, GetStarted) are React islands deferred to Sprint 2;
 * their mount slots are reserved here with stable placeholder elements so the
 * section order is locked and the anchor ID (#contact-therapy) resolves immediately.
 */
import Layout from "../layouts/Layout.astro";
import TherapyHero from "../components/TherapyHero/TherapyHero.astro";
import TherapyStrip2 from "../components/TherapyStrip2/TherapyStrip2.astro";
import DenServices from "../components/DenServices/DenServices.astro";
import BottomHero from "../components/BottomHero/BottomHero.astro";
import Footer from "../components/Footer/Footer.astro";
// Sprint-2 islands NOT imported yet: Header, Specialization, OurApproach, FaqSection, GetStarted.
---
<Layout>
  {/* ISLAND (Sprint 2): <Header client:load currentPath="/services" /> */}
  <TherapyHero />
  <TherapyStrip2 />
  <DenServices />
  {/* ISLAND (Sprint 2): <Specialization client:load /> */}
  {/* ISLAND (Sprint 2): <OurApproach client:load /> */}
  {/* ISLAND (Sprint 2): <FaqSection client:load /> */}
  <div id="contact-therapy">{/* ISLAND (Sprint 2): <GetStarted client:load id="contact-therapy" /> */}</div>
  <BottomHero />
  <Footer />
</Layout>
