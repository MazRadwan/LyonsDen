---
/**
 * index.astro — Home page (/)
 *
 * Composes the static .astro sections in the exact order from audit-report §A
 * "Home / stack". The 5 interactive components (Header, OurApproach, FaqSection,
 * GetStarted) are React islands deferred to Sprint 2; their mount slots are
 * reserved here with stable placeholder elements so the section order is locked
 * and anchor IDs (#about, #contact) resolve immediately.
 */
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero/Hero.astro";
import TherapyStrip from "../components/TherapyStrip/TherapyStrip.astro";
import TherapyServices from "../components/TherapyServices/TherapyServices.astro";
import DontWaitSection from "../components/DontWaitSection/DontWaitSection.astro";
import OurTherapy from "../components/OurTherapy/OurTherapy.astro";
import MinuteSession from "../components/MinuteSession/MinuteSession.astro";
import AreasSupport from "../components/AreasSupport/AreasSupport.astro";
import GettingStarted from "../components/GettingStarted/GettingStarted.astro";
import BioSection from "../components/BioSection/BioSection.astro";
import ProvidesSection from "../components/ProvidesSection/ProvidesSection.astro";
import BottomHero from "../components/BottomHero/BottomHero.astro";
import Footer from "../components/Footer/Footer.astro";
// Sprint-2 islands NOT imported yet: Header, OurApproach, FaqSection, GetStarted.
---
<Layout>
  {/* ISLAND (Sprint 2): <Header client:load currentPath="/" /> */}
  <Hero />
  <TherapyStrip />
  <TherapyServices />
  <DontWaitSection />
  <OurTherapy />
  <MinuteSession />
  <AreasSupport />
  <GettingStarted />
  <BioSection id="about" />
  <ProvidesSection />
  {/* ISLAND (Sprint 2): <OurApproach client:load /> */}
  {/* ISLAND (Sprint 2): <FaqSection client:load /> */}
  <div id="contact">{/* ISLAND (Sprint 2): <GetStarted client:load id="contact" /> */}</div>
  <BottomHero />
  <Footer />
</Layout>
