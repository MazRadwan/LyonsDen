---
/**
 * index.astro — Home page (/)
 *
 * Composes the static .astro sections in the exact order from audit-report §A
 * "Home / stack". The 5 interactive components are mounted as React islands
 * hydrated client:load (Sprint 2, stories 1.2.2–1.2.5).
 *
 * Per-page SEO (Sprint 4 — stories 1.4.1 + 1.4.2):
 *   Passes unique title, description, canonical, OG image, and JSON-LD graph
 *   to Layout.astro. The OG image is resolved via getImage() so Astro optimises
 *   it and the absolute URL is always correct.
 */
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header/Header.island.jsx";
import OurApproach from "../components/OurApproach/OurApproach.island.jsx";
import FaqSection from "../components/FaqSection/FaqSection.jsx";
import GetStarted from "../components/GetStarted/GetStarted.jsx";
import Hero from "../components/Hero/Hero.astro";
import TherapyStrip from "../components/TherapyStrip/TherapyStrip.astro";
import TherapyServices from "../components/TherapyServices/TherapyServices.astro";
import DontWaitSection from "../components/DontWaitSection/DontWaitSection.astro";
import OurTherapy from "../components/OurTherapy/OurTherapy.astro";
import MinuteSession from "../components/MinuteSession/MinuteSession.astro";
import AreasSupport from "../components/AreasSupport/AreasSupport.astro";
import GettingStarted from "../components/GettingStarted/GettingStarted.astro";
import BioSection from "../components/BioSection/BioSection.astro";
import ProvidesSection from "../components/ProvidesSection/ProvidesSection.astro";
import BottomHero from "../components/BottomHero/BottomHero.astro";
import Footer from "../components/Footer/Footer.astro";
import { getImage } from "astro:assets";
import ourApproachHero from "../assets/lyonsdenhero4.jpeg";
const ourApproachBg = (await getImage({ src: ourApproachHero, format: "webp", width: 1920 })).src;
import headerLogoAsset from "../assets/lyonsdenlogo2.png";
const headerLogo = (await getImage({ src: headerLogoAsset, format: "webp", width: 400 })).src;

// OG image: optimised logo resolved to an absolute URL (story 1.4.1)
import ogLogoAsset from "../assets/lyonsdenlogo2.png";
const ogImgSrc = (await getImage({ src: ogLogoAsset, format: "webp", width: 1200 })).src;
const ogImageAbs = new URL(ogImgSrc, Astro.site).href;

// JSON-LD graph (story 1.4.2)
import { siteSchema } from "../lib/structured-data.js";
const canonical = "https://alyonsdentherapy.com/";
const jsonLd = siteSchema({ canonical, image: ogImageAbs });
---
<Layout
  title="A Lyons Den Therapy | Therapy & ADHD Coaching in NY & NJ"
  description="A Lyons Den Therapy — Adam Lyons, LCSW provides therapy and ADHD & Executive Function coaching for teens and adults, virtual and in-person, across New York and New Jersey. Book a free consultation."
  canonical={canonical}
  ogImage={ogImageAbs}
  jsonLd={jsonLd}
>
  <Header client:load currentPath="/" logoSrc={headerLogo} />
  <Hero />
  <TherapyStrip />
  <TherapyServices />
  <DontWaitSection />
  <OurTherapy />
  <MinuteSession />
  <AreasSupport />
  <GettingStarted />
  <BioSection id="about" />
  <ProvidesSection />
  <OurApproach client:load heroSrc={ourApproachBg} />
  <FaqSection client:load />
  <GetStarted client:load id="contact" />
  <BottomHero />
  <Footer />
</Layout>
